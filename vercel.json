{
  "rewrites": [
    {
      "source": "/:agency((?!api|agent-admin|assets)[a-z0-9-]+)/:agent([a-z0-9-]+)",
      "destination": "/api/profile-page?agency=:agency&agent=:agent"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/profile-page.ts": {
      "includeFiles": "dist/index.html"
    }
  }
}
